# Optional override file. If this file is absent, deploy scripts will auto-generate
# xdr-soar-infra/config/platform.env with local bootstrap defaults.
XDR_SOAR_BASE_DOMAIN=soar.example.com
XDR_SOAR_INGRESS_CLASS=nginx
XDR_SOAR_TLS_MODE=auto
XDR_SOAR_CERT_MANAGER_CLUSTER_ISSUER=letsencrypt-prod
XDR_SOAR_ACME_EMAIL=platform-ops@example.com
XDR_SOAR_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
XDR_SOAR_TLS_SECRET_NAME=xdr-soar-platform-tls
XDR_SOAR_NGINX_SSL_PROTOCOLS=TLSv1.3
XDR_SOAR_NGINX_SSL_CIPHERS=TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
# NIST FIPS 203 (ML-KEM) hybrid key-exchange groups, ordered by PQC security level then classical fallbacks
XDR_SOAR_NGINX_SSL_CONF_COMMAND_GROUPS=X25519MLKEM768:SecP256r1MLKEM768:X448MLKEM1024:X25519:secp256r1:secp384r1
# NIST FIPS 204 (ML-DSA) signature algorithms: pure ML-DSA then hybrid, followed by classical fallbacks
XDR_SOAR_NGINX_SSL_CONF_COMMAND_SIGALGS=mldsa65:p384_mldsa65:mldsa87:p521_mldsa87:ecdsa_secp384r1_sha384:rsa_pss_rsae_sha384:rsa_pkcs1_sha384
XDR_SOAR_MQTT_TLS_SECRET_NAME=xdr-soar-mqtt-tls
XDR_SOAR_MQTT_SERVICE_TYPE=NodePort
XDR_SOAR_MQTT_NODE_PORT=30883
MQTT_BROKER_HOST=mqtt.soar.example.com
MQTT_BROKER_PORT=8883
MQTT_TOPIC=/agent/update
UPDATE_API_BASE_URL=https://api.soar.example.com/v1/firmware
